# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/triage_platform"

# ── API ───────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── AI ────────────────────────────────────────────────────────────────────────
# OpenAI API key — if not set, AI enrichment is skipped silently
OPENAI_API_KEY=""

# ── Auth ──────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ── Frontend → API ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
